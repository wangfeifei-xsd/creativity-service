{
  "$defs": {
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Channel Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "dev",
            "test",
            "fat",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "subject_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Type"
        },
        "subject_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        }
      },
      "required": [
        "channel_id",
        "environment"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "规范 JSON 是唯一内容真值；属性每次返回副本，避免浅冻结被嵌套修改绕过。",
  "properties": {
    "snapshot_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "agent_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Agent Id",
      "type": "string"
    },
    "agent_code": {
      "title": "Agent Code",
      "type": "string"
    },
    "agent_name": {
      "title": "Agent Name",
      "type": "string"
    },
    "source_version_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Source Version Id",
      "type": "string"
    },
    "source_revision": {
      "minimum": 1,
      "title": "Source Revision",
      "type": "integer"
    },
    "purpose": {
      "enum": [
        "production",
        "debug",
        "evaluation"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "content_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "dependencies_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependencies Digest",
      "type": "string"
    },
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "payload_json": {
      "title": "Payload Json",
      "type": "string"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "scope",
    "agent_id",
    "agent_code",
    "agent_name",
    "source_version_id",
    "source_revision",
    "purpose",
    "content_digest",
    "dependencies_digest",
    "candidate_digest",
    "payload_json",
    "captured_at"
  ],
  "title": "FrozenExecutionSpec",
  "type": "object"
}
