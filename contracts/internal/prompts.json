{
  "PromptDebugDescriptor": {
    "$defs": {
      "JsonValue": {},
      "PromptRenderView": {
        "additionalProperties": false,
        "properties": {
          "context_limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Context Limit"
          },
          "estimate_method": {
            "default": "按 UTF-8 字节数估算，实际用量以模型记录为准",
            "title": "Estimate Method",
            "type": "string"
          },
          "estimated_remaining_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Estimated Remaining Tokens"
          },
          "estimated_tokens": {
            "title": "Estimated Tokens",
            "type": "integer"
          },
          "masked": {
            "title": "Masked",
            "type": "boolean"
          },
          "sections": {
            "items": {
              "$ref": "#/$defs/RenderedSection"
            },
            "title": "Sections",
            "type": "array"
          }
        },
        "required": [
          "sections",
          "estimated_tokens",
          "masked"
        ],
        "title": "PromptRenderView",
        "type": "object"
      },
      "RenderedSection": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "original_characters": {
            "title": "Original Characters",
            "type": "integer"
          },
          "source": {
            "enum": [
              "system",
              "output",
              "input",
              "tool",
              "memory",
              "platform"
            ],
            "title": "Source",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "truncated_characters": {
            "title": "Truncated Characters",
            "type": "integer"
          }
        },
        "required": [
          "source",
          "label",
          "text",
          "original_characters",
          "truncated_characters"
        ],
        "title": "RenderedSection",
        "type": "object"
      },
      "ResourceVersion": {
        "additionalProperties": false,
        "properties": {
          "channel_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Channel Id",
            "type": "string"
          },
          "configuration_revision": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Configuration Revision"
          },
          "content": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "title": "Content",
            "type": "object"
          },
          "content_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Digest",
            "type": "string"
          },
          "dependencies_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Dependencies Digest",
            "type": "string"
          },
          "dependency_version_ids": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            "title": "Dependency Version Ids",
            "type": "array"
          },
          "draft_revision": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Draft Revision"
          },
          "output_schema": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "title": "Output Schema",
            "type": "object"
          },
          "resource_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Resource Id",
            "type": "string"
          },
          "resource_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Resource Name"
          },
          "resource_type": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Resource Type",
            "type": "string"
          },
          "state": {
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "RETIRED"
            ],
            "title": "State",
            "type": "string"
          },
          "version_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Version Id",
            "type": "string"
          },
          "version_label": {
            "title": "Version Label",
            "type": "string"
          }
        },
        "required": [
          "channel_id",
          "resource_type",
          "resource_id",
          "version_id",
          "version_label",
          "state",
          "draft_revision",
          "content",
          "content_digest",
          "dependency_version_ids",
          "dependencies_digest",
          "output_schema"
        ],
        "title": "ResourceVersion",
        "type": "object"
      },
      "Scope": {
        "additionalProperties": false,
        "properties": {
          "channel_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Channel Id",
            "type": "string"
          },
          "environment": {
            "enum": [
              "dev",
              "test",
              "fat",
              "prod"
            ],
            "title": "Environment",
            "type": "string"
          },
          "subject_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Subject Id"
          },
          "subject_type": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Subject Type"
          }
        },
        "required": [
          "channel_id",
          "environment"
        ],
        "title": "Scope",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "descriptor_digest": {
        "title": "Descriptor Digest",
        "type": "string"
      },
      "expected_constraints": {
        "items": {
          "type": "string"
        },
        "title": "Expected Constraints",
        "type": "array"
      },
      "model_route_version": {
        "title": "Model Route Version",
        "type": "string"
      },
      "prompt": {
        "$ref": "#/$defs/ResourceVersion"
      },
      "purpose": {
        "const": "debug",
        "default": "debug",
        "title": "Purpose",
        "type": "string"
      },
      "rendered": {
        "$ref": "#/$defs/PromptRenderView"
      },
      "sample_digest": {
        "title": "Sample Digest",
        "type": "string"
      },
      "sample_id": {
        "title": "Sample Id",
        "type": "string"
      },
      "scope": {
        "$ref": "#/$defs/Scope"
      },
      "test_id": {
        "title": "Test Id",
        "type": "string"
      }
    },
    "required": [
      "test_id",
      "scope",
      "prompt",
      "model_route_version",
      "sample_id",
      "sample_digest",
      "rendered",
      "expected_constraints",
      "descriptor_digest"
    ],
    "title": "PromptDebugDescriptor",
    "type": "object"
  },
