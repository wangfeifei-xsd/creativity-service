{
  "CaseInput": {
    "$defs": {
      "Assertion": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "default": "quality",
            "enum": [
              "quality",
              "schema",
              "cross_scope",
              "secret_leak",
              "fabricated_entity",
              "calculation",
              "authorization",
              "citation"
            ],
            "title": "Category",
            "type": "string"
          },
          "expected": {
            "default": null,
            "title": "Expected"
          },
          "kind": {
            "enum": [
              "schema",
              "equal",
              "numeric",
              "one_of",
              "subset",
              "forbidden",
              "citation"
            ],
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "path": {
            "default": "",
            "maxLength": 512,
            "title": "Path",
            "type": "string"
          },
          "tolerance": {
            "default": 0,
            "minimum": 0,
            "title": "Tolerance",
            "type": "number"
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "title": "Assertion",
        "type": "object"
      },
      "EvaluationSource": {
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Resource Id",
            "type": "string"
          },
          "resource_type": {
            "enum": [
              "run",
              "version",
              "artifact"
            ],
            "title": "Resource Type",
            "type": "string"
          }
        },
        "required": [
          "resource_type",
          "resource_id"
        ],
        "title": "EvaluationSource",
        "type": "object"
      },
      "FixtureCall": {
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "data": {
            "default": null,
            "title": "Data"
          },
          "error_code": {
            "anyOf": [
              {
                "enum": [
                  "TOOL_TIMEOUT",
                  "TOOL_UNAVAILABLE",
                  "TOOL_RESULT_INVALID"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error Code"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "source_version": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Source Version",
            "type": "string"
          },
          "tool_version_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Tool Version Id",
            "type": "string"
          }
        },
        "required": [
          "tool_version_id",
          "arguments",
          "source_version",
          "observed_at"
        ],
        "title": "FixtureCall",
        "type": "object"
      },
      "HumanLabel": {
        "additionalProperties": false,
        "properties": {
          "decision": {
            "enum": [
              "approved",
              "rejected",
              "disputed"
            ],
            "title": "Decision",
            "type": "string"
          },
          "reason": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "decision",
          "reason"
        ],
        "title": "HumanLabel",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "assertions": {
        "items": {
          "$ref": "#/$defs/Assertion"
        },
        "maxItems": 100,
        "title": "Assertions",
        "type": "array"
      },
      "case_key": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "title": "Case Key",
        "type": "string"
      },
      "context": {
        "additionalProperties": true,
        "title": "Context",
        "type": "object"
      },
      "expected_error": {
        "anyOf": [
          {
            "maxLength": 128,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Error"
      },
      "fixture": {
        "items": {
          "$ref": "#/$defs/FixtureCall"
        },
        "maxItems": 100,
        "title": "Fixture",
        "type": "array"
      },
      "human_label": {
        "anyOf": [
          {
            "$ref": "#/$defs/HumanLabel"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "input": {
        "additionalProperties": true,
        "title": "Input",
        "type": "object"
      },
      "label_source": {
        "maxLength": 256,
        "minLength": 1,
        "title": "Label Source",
        "type": "string"
      },
      "labels": {
        "items": {
          "type": "string"
        },
        "maxItems": 32,
        "title": "Labels",
        "type": "array"
      },
      "source_mode": {
        "default": "all",
        "enum": [
          "all",
          "independent"
        ],
        "title": "Source Mode",
        "type": "string"
      },
      "source_refs": {
        "items": {
          "$ref": "#/$defs/EvaluationSource"
        },
        "maxItems": 64,
        "title": "Source Refs",
        "type": "array"
      },
      "title": {
        "maxLength": 255,
        "minLength": 1,
        "title": "Title",
        "type": "string"
      }
    },
    "required": [
      "case_key",
      "title",
      "input",
      "label_source"
    ],
    "title": "CaseInput",
    "type": "object"
  },
  "ComparisonReport": {
    "additionalProperties": false,
    "properties": {
      "baseline": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "title": "Baseline"
      },
      "candidates": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Candidates",
        "type": "array"
      },
      "complete": {
        "title": "Complete",
        "type": "boolean"
      },
      "cost": {
        "additionalProperties": true,
        "title": "Cost",
        "type": "object"
      },
      "evaluation_id": {
        "title": "Evaluation Id",
        "type": "string"
      },
      "human_review": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "title": "Human Review"
      },
      "latency": {
        "additionalProperties": true,
        "title": "Latency",
        "type": "object"
      },
      "report_digest": {
        "title": "Report Digest",
        "type": "string"
      },
      "report_id": {
        "title": "Report Id",
        "type": "string"
      },
      "reproducible": {
        "title": "Reproducible",
        "type": "boolean"
      },
      "results": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Results",
        "type": "array"
      },
      "revision": {
        "title": "Revision",
        "type": "integer"
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      }
    },
    "required": [
      "report_id",
      "evaluation_id",
      "revision",
      "report_digest",
      "reproducible",
      "complete",
      "candidates",
      "results",
      "cost",
      "latency",
      "baseline",
      "human_review",
      "warnings"
    ],
    "title": "ComparisonReport",
    "type": "object"
  },
