  "ImportInput": {
    "additionalProperties": false,
    "properties": {
      "captured_at": {
        "format": "date-time",
        "title": "Captured At",
        "type": "string"
      },
      "commit": {
        "default": false,
        "title": "Commit",
        "type": "boolean"
      },
      "content": {
        "maxLength": 2000000,
        "minLength": 1,
        "title": "Content",
        "type": "string"
      },
      "format": {
        "enum": [
          "jsonl",
          "csv"
        ],
        "title": "Format",
        "type": "string"
      },
      "mapping": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Mapping",
        "type": "object"
      },
      "preview_digest": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Preview Digest"
      },
      "revision": {
        "minimum": 1,
        "title": "Revision",
        "type": "integer"
      },
      "version_label": {
        "maxLength": 128,
        "minLength": 1,
        "title": "Version Label",
        "type": "string"
      }
    },
    "required": [
      "format",
      "content",
      "revision",
      "version_label",
      "captured_at"
    ],
    "title": "ImportInput",
    "type": "object"
  },
