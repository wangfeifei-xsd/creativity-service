{
  "LifecycleEvent": {
    "additionalProperties": false,
    "properties": {
      "channel_id": {
        "title": "Channel Id",
        "type": "string"
      },
      "current_status": {
        "title": "Current Status",
        "type": "string"
      },
      "environment": {
        "anyOf": [
          {
            "enum": [
              "dev",
              "test",
              "fat",
              "prod"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Environment"
      },
      "event_id": {
        "title": "Event Id",
        "type": "string"
      },
      "event_type": {
        "title": "Event Type",
        "type": "string"
      },
      "occurred_at": {
        "format": "date-time",
        "title": "Occurred At",
        "type": "string"
      },
      "previous_status": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Previous Status"
      },
      "revision": {
        "title": "Revision",
        "type": "integer"
      },
      "target_id": {
        "title": "Target Id",
        "type": "string"
      },
      "target_type": {
        "title": "Target Type",
        "type": "string"
      }
    },
    "required": [
      "event_id",
      "channel_id",
      "event_type",
      "target_type",
      "target_id",
      "environment",
      "previous_status",
      "current_status",
      "revision",
      "occurred_at"
    ],
    "title": "LifecycleEvent",
    "type": "object"
  },
  "UsageQuery": {
    "additionalProperties": false,
    "properties": {
      "end_at": {
        "format": "date-time",
        "title": "End At",
        "type": "string"
      },
      "start_at": {
        "format": "date-time",
        "title": "Start At",
        "type": "string"
      }
    },
    "required": [
      "start_at",
      "end_at"
    ],
    "title": "UsageQuery",
    "type": "object"
  },
  "UsageView": {
    "$defs": {
      "Money": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "Money",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "aggregate_updated_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Aggregate Updated At"
      },
      "calls": {
        "minimum": 0,
        "title": "Calls",
        "type": "integer"
      },
      "channel_id": {
        "title": "Channel Id",
        "type": "string"
      },
      "channel_name": {
        "title": "Channel Name",
        "type": "string"
      },
      "costs": {
        "items": {
          "$ref": "#/$defs/Money"
        },
        "title": "Costs",
        "type": "array"
      },
      "end_at": {
        "format": "date-time",
        "title": "End At",
        "type": "string"
      },
      "input_tokens": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Input Tokens"
      },
      "missing_usage": {
        "default": 0,
        "title": "Missing Usage",
        "type": "integer"
      },
      "output_tokens": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Output Tokens"
      },
      "price_complete": {
        "default": false,
        "title": "Price Complete",
        "type": "boolean"
      },
      "provisional_costs": {
        "items": {
          "$ref": "#/$defs/Money"
        },
        "title": "Provisional Costs",
        "type": "array"
      },
      "requests": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Requests"
      },
      "start_at": {
        "format": "date-time",
        "title": "Start At",
        "type": "string"
      },
      "unpriced": {
        "default": 0,
        "title": "Unpriced",
        "type": "integer"
      }
    },
    "required": [
      "channel_id",
      "channel_name",
      "start_at",
      "end_at",
      "calls",
      "input_tokens",
      "output_tokens",
      "costs"
    ],
    "title": "UsageView",
    "type": "object"
  }
}
