  "BudgetCreate": {
    "additionalProperties": false,
    "properties": {
      "currency": {
        "anyOf": [
          {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Currency"
      },
      "limit_value": {
        "decimal_places": 8,
        "ge": 0,
        "max_digits": 24,
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "title": "Limit Value",
        "type": "string"
      },
      "mode": {
        "default": "HARD",
        "enum": [
          "HARD",
          "ALERT_ONLY"
        ],
        "title": "Mode",
        "type": "string"
      },
      "name": {
        "maxLength": 128,
        "minLength": 1,
        "title": "Name",
        "type": "string"
      },
      "period": {
        "default": "month",
        "enum": [
          "minute",
          "hour",
          "day",
          "month"
        ],
        "title": "Period",
        "type": "string"
      },
      "scope_id": {
        "maxLength": 128,
        "minLength": 1,
        "title": "Scope Id",
        "type": "string"
      },
      "scope_type": {
        "enum": [
          "channel",
          "key",
          "model"
        ],
        "title": "Scope Type",
        "type": "string"
      },
      "status": {
        "default": "ACTIVE",
        "enum": [
          "ACTIVE",
          "DISABLED"
        ],
        "title": "Status",
        "type": "string"
      },
      "thresholds": {
        "items": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        "title": "Thresholds",
        "type": "array"
      },
      "timezone": {
        "default": "Asia/Shanghai",
        "title": "Timezone",
        "type": "string"
      },
      "unit": {
        "default": "amount",
        "enum": [
          "amount",
          "tokens",
          "attempts",
          "requests",
          "concurrency"
        ],
        "title": "Unit",
        "type": "string"
      }
    },
    "required": [
      "name",
      "scope_type",
      "scope_id",
      "limit_value"
    ],
    "title": "BudgetCreate",
    "type": "object"
  },
