  "CandidateInput": {
    "$defs": {
      "JsonValue": {},
      "SourceInput": {
        "additionalProperties": false,
        "description": "仅供受控运行端口使用，HTTP 明确保存不接收来源标识。",
        "properties": {
          "source_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Source Id",
            "type": "string"
          },
          "source_type": {
            "enum": [
              "message",
              "evidence",
              "memory"
            ],
            "title": "Source Type",
            "type": "string"
          },
          "source_version": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Source Version",
            "type": "string"
          }
        },
        "required": [
          "source_type",
          "source_id",
          "source_version"
        ],
        "title": "SourceInput",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "expires_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expires At"
      },
      "intent": {
        "enum": [
          "TASK_ONLY",
          "INFERRED",
          "EXPLICIT"
        ],
        "title": "Intent",
        "type": "string"
      },
      "key": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "title": "Key",
        "type": "string"
      },
      "memory_type": {
        "default": "PREFERENCE",
        "title": "Memory Type",
        "type": "string"
      },
      "source": {
        "$ref": "#/$defs/SourceInput"
      },
      "value": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "required": [
      "key",
      "value",
      "intent",
      "source"
    ],
    "title": "CandidateInput",
    "type": "object"
  },
