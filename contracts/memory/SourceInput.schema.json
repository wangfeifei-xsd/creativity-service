{
  "additionalProperties": false,
  "description": "仅供受控运行端口使用，HTTP 明确保存不接收来源标识。",
  "properties": {
    "source_type": {
      "enum": [
        "message",
        "evidence"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Version",
      "type": "string"
    }
  },
  "required": [
    "source_type",
    "source_id",
    "source_version"
  ],
  "title": "SourceInput",
  "type": "object"
}
