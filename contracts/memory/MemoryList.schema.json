{
  "$defs": {
    "JsonValue": {},
    "MemoryAttribute": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "memory_type": {
          "default": "PREFERENCE",
          "enum": [
            "PREFERENCE",
            "FACT"
          ],
          "title": "Memory Type",
          "type": "string"
        },
        "value_schema": {
          "additionalProperties": true,
          "title": "Value Schema",
          "type": "object"
        }
      },
      "required": [
        "key",
        "label",
        "value_schema"
      ],
      "title": "MemoryAttribute",
      "type": "object"
    },
    "MemorySourceView": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_type_label": {
          "title": "Source Type Label",
          "type": "string"
        },
        "source_version": {
          "title": "Source Version",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source_type_label",
        "source_version",
        "observed_at"
      ],
      "title": "MemorySourceView",
      "type": "object"
    },
    "MemoryView": {
      "additionalProperties": false,
      "properties": {
        "memory_id": {
          "title": "Memory Id",
          "type": "string"
        },
        "layer": {
          "enum": [
            "archive",
            "profile"
          ],
          "title": "Layer",
          "type": "string"
        },
        "layer_label": {
          "title": "Layer Label",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "memory_type": {
          "title": "Memory Type",
          "type": "string"
        },
        "type_label": {
          "title": "Type Label",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "value_label": {
          "title": "Value Label",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "status_label": {
          "title": "Status Label",
          "type": "string"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "subject_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject Name"
        },
        "usage_count": {
          "title": "Usage Count",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/MemorySourceView"
          },
          "title": "Sources",
          "type": "array"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/VisibleAction"
          },
          "title": "Actions",
          "type": "array"
        }
      },
      "required": [
        "memory_id",
        "layer",
        "layer_label",
        "key",
        "display_name",
        "memory_type",
        "type_label",
        "value",
        "value_label",
        "status",
        "status_label",
        "confirmed",
        "expires_at",
        "revision",
        "version_id",
        "version",
        "subject_name",
        "usage_count",
        "created_at",
        "sources",
        "actions"
      ],
      "title": "MemoryView",
      "type": "object"
    },
    "VisibleAction": {
      "additionalProperties": false,
      "properties": {
        "action_key": {
          "title": "Action Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "action_key",
        "label"
      ],
      "title": "VisibleAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/MemoryView"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "has_more": {
      "title": "Has More",
      "type": "boolean"
    },
    "attributes": {
      "items": {
        "$ref": "#/$defs/MemoryAttribute"
      },
      "title": "Attributes",
      "type": "array"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/VisibleAction"
      },
      "title": "Actions",
      "type": "array"
    }
  },
  "required": [
    "items",
    "next_cursor",
    "has_more",
    "attributes",
    "actions"
  ],
  "title": "MemoryList",
  "type": "object"
}
