{
  "$defs": {
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Channel Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "dev",
            "test",
            "fat",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "subject_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        },
        "subject_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Type"
        }
      },
      "required": [
        "channel_id",
        "environment"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_networks": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Allowed Networks",
      "type": "array"
    },
    "config_digest": {
      "title": "Config Digest",
      "type": "string"
    },
    "connection_id": {
      "title": "Connection Id",
      "type": "string"
    },
    "connection_revision": {
      "title": "Connection Revision",
      "type": "integer"
    },
    "connection_version_id": {
      "title": "Connection Version Id",
      "type": "string"
    },
    "endpoint": {
      "title": "Endpoint",
      "type": "string"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "model_name": {
      "title": "Model Name",
      "type": "string"
    },
    "model_revision": {
      "title": "Model Revision",
      "type": "integer"
    },
    "model_version_id": {
      "title": "Model Version Id",
      "type": "string"
    },
    "parameter_allowlist": {
      "items": {
        "type": "string"
      },
      "title": "Parameter Allowlist",
      "type": "array"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "protocol": {
      "enum": [
        "chat_completions",
        "responses",
        "anthropic_messages",
        "gemini_generate_content"
      ],
      "title": "Protocol",
      "type": "string"
    },
    "provider_credential_id": {
      "title": "Provider Credential Id",
      "type": "string"
    },
    "provider_model_name": {
      "title": "Provider Model Name",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "timeout_seconds": {
      "title": "Timeout Seconds",
      "type": "integer"
    }
  },
  "required": [
    "scope",
    "model_id",
    "model_version_id",
    "model_revision",
    "model_name",
    "connection_id",
    "connection_version_id",
    "connection_revision",
    "provider_credential_id",
    "protocol",
    "endpoint",
    "provider_model_name",
    "timeout_seconds",
    "parameters",
    "parameter_allowlist",
    "config_digest"
  ],
  "title": "FrozenModel",
  "type": "object"
}
