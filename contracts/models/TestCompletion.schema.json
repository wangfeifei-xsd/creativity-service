{
  "$defs": {
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "attempt_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Attempt Ids",
          "type": "array"
        },
        "case": {
          "enum": [
            "text",
            "schema",
            "tools",
            "stream_cancel",
            "usage",
            "embedding"
          ],
          "title": "Case",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "case",
        "passed",
        "attempt_ids"
      ],
      "title": "CaseResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "config_digest": {
      "title": "Config Digest",
      "type": "string"
    },
    "evidence": {
      "enum": [
        "fixture",
        "live"
      ],
      "title": "Evidence",
      "type": "string"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "minItems": 1,
      "title": "Results",
      "type": "array"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "config_digest",
    "results",
    "latency_ms",
    "evidence"
  ],
  "title": "TestCompletion",
  "type": "object"
}
