{
  "$defs": {
    "AnalysisPolicy": {
      "additionalProperties": false,
      "properties": {
        "rows_path": {
          "default": [
            "rows"
          ],
          "items": {
            "type": "string"
          },
          "title": "Rows Path",
          "type": "array"
        },
        "max_rows": {
          "default": 1000,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Rows",
          "type": "integer"
        }
      },
      "title": "AnalysisPolicy",
      "type": "object"
    },
    "CachePolicy": {
      "additionalProperties": false,
      "properties": {
        "ttl_seconds": {
          "default": 0,
          "maximum": 3600,
          "minimum": 0,
          "title": "Ttl Seconds",
          "type": "integer"
        },
        "freshness_seconds": {
          "default": 60,
          "maximum": 86400,
          "minimum": 1,
          "title": "Freshness Seconds",
          "type": "integer"
        },
        "volatile": {
          "default": false,
          "title": "Volatile",
          "type": "boolean"
        }
      },
      "title": "CachePolicy",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "delay_ms": {
          "default": 100,
          "maximum": 2000,
          "minimum": 0,
          "title": "Delay Ms",
          "type": "integer"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "ScriptBinding": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Digest",
          "type": "string"
        },
        "skill_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Skill Version Id",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_/-]+\\.py$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_digest",
        "skill_version_id",
        "path"
      ],
      "title": "ScriptBinding",
      "type": "object"
    },
    "SubjectRequirements": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "allowed_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Types",
          "type": "array"
        }
      },
      "title": "SubjectRequirements",
      "type": "object"
    },
    "ToolBinding": {
      "additionalProperties": false,
      "properties": {
        "adapter_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Adapter Key",
          "type": "string"
        },
        "implementation_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Implementation Version",
          "type": "string"
        },
        "connection_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connection Id"
        },
        "script": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScriptBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "adapter_key",
        "implementation_version"
      ],
      "title": "ToolBinding",
      "type": "object"
    },
    "WritePolicy": {
      "additionalProperties": false,
      "properties": {
        "status_tool_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Status Tool Version Id",
          "type": "string"
        },
        "max_submissions": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Submissions",
          "type": "integer"
        },
        "max_checks": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Checks",
          "type": "integer"
        }
      },
      "required": [
        "status_tool_version_id"
      ],
      "title": "WritePolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "input_schema": {
      "additionalProperties": true,
      "title": "Input Schema",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "Output Schema",
      "type": "object"
    },
    "model_fields_allowed": {
      "items": {
        "type": "string"
      },
      "title": "Model Fields Allowed",
      "type": "array"
    },
    "binding": {
      "$ref": "#/$defs/ToolBinding"
    },
    "effect_type": {
      "enum": [
        "READ_ONLY",
        "IDEMPOTENT_WRITE",
        "EXTERNAL_WRITE"
      ],
      "title": "Effect Type",
      "type": "string"
    },
    "required_scopes": {
      "default": [
        "run:create"
      ],
      "items": {
        "type": "string"
      },
      "title": "Required Scopes",
      "type": "array"
    },
    "environments": {
      "items": {
        "enum": [
          "dev",
          "test",
          "fat",
          "prod"
        ],
        "type": "string"
      },
      "title": "Environments",
      "type": "array"
    },
    "subject_requirements": {
      "$ref": "#/$defs/SubjectRequirements",
      "default": {
        "required": true,
        "allowed_types": []
      }
    },
    "timeout_seconds": {
      "default": 10,
      "maximum": 120,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "max_result_size": {
      "default": 262144,
      "maximum": 2097152,
      "minimum": 256,
      "title": "Max Result Size",
      "type": "integer"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy",
      "default": {
        "max_attempts": 1,
        "delay_ms": 100
      }
    },
    "cache_policy": {
      "$ref": "#/$defs/CachePolicy",
      "default": {
        "ttl_seconds": 0,
        "freshness_seconds": 60,
        "volatile": false
      }
    },
    "idempotency_policy": {
      "default": "none",
      "enum": [
        "none",
        "source_key"
      ],
      "title": "Idempotency Policy",
      "type": "string"
    },
    "write_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/WritePolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "analysis_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "input_schema",
    "output_schema",
    "model_fields_allowed",
    "binding",
    "effect_type",
    "environments"
  ],
  "title": "ToolDefinition",
  "type": "object"
}
