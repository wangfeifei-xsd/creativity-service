{
  "$defs": {
    "JsonValue": {},
    "ResourceVersion": {
      "additionalProperties": false,
      "properties": {
        "resource_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Name"
        },
        "configuration_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Revision"
        },
        "channel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Channel Id",
          "type": "string"
        },
        "resource_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Resource Type",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Resource Id",
          "type": "string"
        },
        "version_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Version Id",
          "type": "string"
        },
        "version_label": {
          "title": "Version Label",
          "type": "string"
        },
        "state": {
          "enum": [
            "DRAFT",
            "PUBLISHED",
            "RETIRED"
          ],
          "title": "State",
          "type": "string"
        },
        "draft_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Draft Revision"
        },
        "content": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Content",
          "type": "object"
        },
        "content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "dependency_version_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Dependency Version Ids",
          "type": "array"
        },
        "dependencies_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependencies Digest",
          "type": "string"
        },
        "output_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Output Schema",
          "type": "object"
        }
      },
      "required": [
        "channel_id",
        "resource_type",
        "resource_id",
        "version_id",
        "version_label",
        "state",
        "draft_revision",
        "content",
        "content_digest",
        "dependency_version_ids",
        "dependencies_digest",
        "output_schema"
      ],
      "title": "ResourceVersion",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Channel Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "dev",
            "test",
            "fat",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "subject_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Type"
        },
        "subject_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        }
      },
      "required": [
        "channel_id",
        "environment"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "由 17 读取持久化运行、Agent 白名单和当前授权后提供。",
  "properties": {
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "step_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Step Id",
      "type": "string"
    },
    "agent_version_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Agent Version Id",
      "type": "string"
    },
    "tool_version_ids": {
      "items": {
        "type": "string"
      },
      "title": "Tool Version Ids",
      "type": "array",
      "uniqueItems": true
    },
    "allowed_actions": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Actions",
      "type": "array",
      "uniqueItems": true
    },
    "authorization_revision": {
      "title": "Authorization Revision",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "production",
        "debug",
        "evaluation"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "draft_revisions": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Draft Revisions",
      "type": "object"
    },
    "frozen_tool": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceVersion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "frozen_skills": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResourceVersion"
      },
      "title": "Frozen Skills",
      "type": "array"
    }
  },
  "required": [
    "scope",
    "run_id",
    "step_id",
    "agent_version_id",
    "tool_version_ids",
    "allowed_actions",
    "authorization_revision",
    "purpose"
  ],
  "title": "RunToolGrant",
  "type": "object"
}
