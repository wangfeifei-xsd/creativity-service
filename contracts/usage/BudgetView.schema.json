{
  "additionalProperties": false,
  "properties": {
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "scope_type": {
      "enum": [
        "channel",
        "key",
        "model"
      ],
      "title": "Scope Type",
      "type": "string"
    },
    "scope_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Scope Id",
      "type": "string"
    },
    "period": {
      "default": "month",
      "enum": [
        "minute",
        "hour",
        "day",
        "month"
      ],
      "title": "Period",
      "type": "string"
    },
    "timezone": {
      "default": "Asia/Shanghai",
      "title": "Timezone",
      "type": "string"
    },
    "currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "limit_value": {
      "decimal_places": 8,
      "ge": 0,
      "max_digits": 24,
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Limit Value",
      "type": "string"
    },
    "unit": {
      "default": "amount",
      "enum": [
        "amount",
        "tokens",
        "attempts",
        "requests",
        "concurrency"
      ],
      "title": "Unit",
      "type": "string"
    },
    "mode": {
      "default": "HARD",
      "enum": [
        "HARD",
        "ALERT_ONLY"
      ],
      "title": "Mode",
      "type": "string"
    },
    "thresholds": {
      "items": {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
      },
      "title": "Thresholds",
      "type": "array"
    },
    "status": {
      "default": "ACTIVE",
      "enum": [
        "ACTIVE",
        "DISABLED"
      ],
      "title": "Status",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "version_id": {
      "title": "Version Id",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "integer"
    },
    "mode_label": {
      "title": "Mode Label",
      "type": "string"
    },
    "unit_label": {
      "title": "Unit Label",
      "type": "string"
    },
    "scope_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Scope Name"
    },
    "used": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Used"
    },
    "remaining": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Remaining"
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blocked Reason"
    }
  },
  "required": [
    "name",
    "scope_type",
    "scope_id",
    "limit_value",
    "id",
    "version_id",
    "revision",
    "mode_label",
    "unit_label",
    "scope_name",
    "used",
    "remaining"
  ],
  "title": "BudgetView",
  "type": "object"
}
