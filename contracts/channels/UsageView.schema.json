{
  "$defs": {
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "channel_id": {
      "title": "Channel Id",
      "type": "string"
    },
    "channel_name": {
      "title": "Channel Name",
      "type": "string"
    },
    "start_at": {
      "format": "date-time",
      "title": "Start At",
      "type": "string"
    },
    "end_at": {
      "format": "date-time",
      "title": "End At",
      "type": "string"
    },
    "calls": {
      "minimum": 0,
      "title": "Calls",
      "type": "integer"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Tokens"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Output Tokens"
    },
    "costs": {
      "items": {
        "$ref": "#/$defs/Money"
      },
      "title": "Costs",
      "type": "array"
    },
    "provisional_costs": {
      "items": {
        "$ref": "#/$defs/Money"
      },
      "title": "Provisional Costs",
      "type": "array"
    },
    "requests": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requests"
    },
    "missing_usage": {
      "default": 0,
      "title": "Missing Usage",
      "type": "integer"
    },
    "unpriced": {
      "default": 0,
      "title": "Unpriced",
      "type": "integer"
    },
    "price_complete": {
      "default": false,
      "title": "Price Complete",
      "type": "boolean"
    },
    "aggregate_updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aggregate Updated At"
    }
  },
  "required": [
    "channel_id",
    "channel_name",
    "start_at",
    "end_at",
    "calls",
    "input_tokens",
    "output_tokens",
    "costs"
  ],
  "title": "UsageView",
  "type": "object"
}
