  "components": {
    "schemas": {
      "AdmissionReceipt": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "CANCEL_REQUESTED",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED",
              "TIMED_OUT"
            ],
            "title": "State"
          },
          "state_label": {
            "type": "string",
            "title": "State Label"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "deadline": {
            "type": "string",
            "format": "date-time",
            "title": "Deadline"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          },
          "events_url": {
            "type": "string",
            "title": "Events Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "state",
          "state_label",
          "created_at",
          "deadline",
          "status_url",
          "events_url"
        ],
        "title": "AdmissionReceipt"
      },
      "Artifact": {
        "properties": {
          "artifact_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Artifact Id"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "content_type": {
            "type": "string",
            "title": "Content Type"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Size Bytes"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256"
          },
          "state": {
            "type": "string",
            "enum": [
              "STAGED",
              "AVAILABLE",
              "DELETING",
              "DELETED"
            ],
            "title": "State"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "download_path": {
            "type": "string",
            "title": "Download Path"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "artifact_id",
          "scope",
          "name",
          "content_type",
          "size_bytes",
          "sha256",
          "state",
          "expires_at",
          "download_path"
        ],
        "title": "Artifact"
      },
      "BusinessResult": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version"
          },
          "business_status": {
            "type": "string",
            "enum": [
              "COMPLETED",
              "NEEDS_INPUT",
              "NO_MATCH",
              "INSUFFICIENT_DATA",
              "PARTIAL"
            ],
            "title": "Business Status"
          },
          "data": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Data"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "evidence_refs": {
            "items": {
              "$ref": "#/components/schemas/EvidenceRef"
            },
            "type": "array",
            "title": "Evidence Refs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "business_status",
          "data",
          "warnings",
          "evidence_refs"
        ],
        "title": "BusinessResult"
      },
      "EvidenceLocation": {
        "properties": {
          "field_path": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field Path"
          },
          "text_start": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Text Start"
          },
          "text_end": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Text End"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field_path",
          "text_start",
          "text_end"
        ],
        "title": "EvidenceLocation"
      },
      "EvidenceRef": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Evidence Id"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "source_type": {
            "type": "string",
            "title": "Source Type"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "source_version": {
            "type": "string",
            "title": "Source Version"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "location": {
            "$ref": "#/components/schemas/EvidenceLocation"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "authorized_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Authorized Actions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_id",
          "scope",
          "source_type",
          "source_id",
          "source_version",
          "observed_at",
          "location",
          "title",
          "authorized_actions"
        ],
