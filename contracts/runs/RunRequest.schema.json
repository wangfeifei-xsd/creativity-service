{
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "会话调用保留客户端消息标识，由 12 的事务钩子校验和关联。",
  "properties": {
    "agent_code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Agent Code",
      "type": "string"
    },
    "input": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Input",
      "type": "object"
    },
    "conversation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Id"
    },
    "delivery": {
      "default": "async",
      "pattern": "^(async|sync|stream)$",
      "title": "Delivery",
      "type": "string"
    },
    "client_message_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Client Message Id"
    }
  },
  "required": [
    "agent_code",
    "input"
  ],
  "title": "RunRequest",
  "type": "object"
}
