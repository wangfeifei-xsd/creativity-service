{
  "$defs": {
    "CandidateInput": {
      "additionalProperties": false,
      "properties": {
        "version_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Version Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "version_id",
        "revision"
      ],
      "title": "CandidateInput",
      "type": "object"
    },
    "EvaluationBudget": {
      "additionalProperties": false,
      "properties": {
        "max_runs": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Runs",
          "type": "integer"
        },
        "token_limit": {
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Token Limit",
          "type": "integer"
        },
        "cost_limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "max_runs",
        "token_limit"
      ],
      "title": "EvaluationBudget",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,25}0*$)\\d{0,16}\\.\\d{0,8}0*$)",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "experiment_prompt_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experiment Prompt Id"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "dataset_version_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Dataset Version Id",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateInput"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Candidates",
      "type": "array"
    },
    "baseline_candidate_version_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Candidate Version Id"
    },
    "baseline_evaluation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Evaluation Id"
    },
    "execution_mode": {
      "default": "fixture",
      "enum": [
        "fixture",
        "live_readonly"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "concurrency": {
      "default": 2,
      "maximum": 16,
      "minimum": 1,
      "title": "Concurrency",
      "type": "integer"
    },
    "budget": {
      "$ref": "#/$defs/EvaluationBudget"
    },
    "minimum_pass_rate": {
      "default": 1,
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Pass Rate",
      "type": "number"
    },
    "maximum_regression": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Maximum Regression",
      "type": "number"
    },
    "release_target": {
      "default": false,
      "title": "Release Target",
      "type": "boolean"
    },
    "expires_days": {
      "default": 7,
      "maximum": 30,
      "minimum": 1,
      "title": "Expires Days",
      "type": "integer"
    }
  },
  "required": [
    "name",
    "dataset_version_id",
    "candidates",
    "budget"
  ],
  "title": "EvaluationCreate",
  "type": "object"
}
