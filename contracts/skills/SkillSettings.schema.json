{
  "$defs": {
    "SkillToolRequirement": {
      "additionalProperties": false,
      "properties": {
        "tool_code": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Tool Code",
          "type": "string"
        },
        "version_label": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version Label",
          "type": "string"
        },
        "source_type": {
          "anyOf": [
            {
              "enum": [
                "mcp",
                "http",
                "builtin"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Type"
        },
        "input_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Schema"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        }
      },
      "required": [
        "tool_code",
        "version_label"
      ],
      "title": "SkillToolRequirement",
      "type": "object"
    },
    "SkillVariable": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value_type": {
          "default": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "object",
            "array"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "title": "SkillVariable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "change_note": {
      "default": "",
      "maxLength": 4000,
      "title": "Change Note",
      "type": "string"
    },
    "tool_requirements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SkillToolRequirement"
      },
      "maxItems": 32,
      "title": "Tool Requirements",
      "type": "array"
    },
    "tool_bindings": {
      "additionalProperties": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "type": "string"
      },
      "maxProperties": 32,
      "title": "Tool Bindings",
      "type": "object"
    },
    "required_model_capabilities": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Required Model Capabilities",
      "type": "array"
    },
    "input_variables": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SkillVariable"
      },
      "maxItems": 64,
      "title": "Input Variables",
      "type": "array"
    },
    "loading_mode": {
      "default": "on_demand",
      "enum": [
        "mandatory",
        "on_demand"
      ],
      "title": "Loading Mode",
      "type": "string"
    },
    "priority": {
      "default": 0,
      "maximum": 1000,
      "minimum": -1000,
      "title": "Priority",
      "type": "integer"
    },
    "context_budget": {
      "default": 16000,
      "maximum": 200000,
      "minimum": 1,
      "title": "Context Budget",
      "type": "integer"
    },
    "allowed_agents": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Allowed Agents",
      "type": "array"
    },
    "conflict_groups": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Conflict Groups",
      "type": "array"
    }
  },
  "title": "SkillSettings",
  "type": "object"
}
