{
  "additionalProperties": false,
  "properties": {
    "channel_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Channel Id",
      "type": "string"
    },
    "skill_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Skill Id",
      "type": "string"
    },
    "version_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Version Id",
      "type": "string"
    },
    "content_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "package_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Package Hash",
      "type": "string"
    },
    "dependencies_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependencies Digest",
      "type": "string"
    },
    "required_tool_versions": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Required Tool Versions",
      "type": "array"
    },
    "required_model_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Required Model Capabilities",
      "type": "array"
    }
  },
  "required": [
    "channel_id",
    "skill_id",
    "version_id",
    "content_digest",
    "package_hash",
    "dependencies_digest",
    "required_tool_versions",
    "required_model_capabilities"
  ],
  "title": "SkillDependencySummary",
  "type": "object"
}
