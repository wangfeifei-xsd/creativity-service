{
  "$defs": {
    "SkillBinding": {
      "additionalProperties": false,
      "properties": {
        "version_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Version Id",
          "type": "string"
        },
        "selected": {
          "default": false,
          "title": "Selected",
          "type": "boolean"
        },
        "selected_files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Selected Files",
          "type": "array"
        },
        "trigger_reason": {
          "default": "按需选择",
          "maxLength": 256,
          "minLength": 1,
          "title": "Trigger Reason",
          "type": "string"
        },
        "variables": {
          "additionalProperties": true,
          "title": "Variables",
          "type": "object"
        },
        "loading_mode": {
          "anyOf": [
            {
              "enum": [
                "mandatory",
                "on_demand"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loading Mode"
        },
        "priority": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": -1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority"
        }
      },
      "required": [
        "version_id"
      ],
      "title": "SkillBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "由 16/17 验证 Agent、模型与工具授权后构造，不能直接作为业务 API 正文。",
  "properties": {
    "bindings": {
      "items": {
        "$ref": "#/$defs/SkillBinding"
      },
      "maxItems": 32,
      "title": "Bindings",
      "type": "array"
    },
    "agent_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Id"
    },
    "authorized_tool_versions": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Authorized Tool Versions",
      "type": "array"
    },
    "model_capabilities": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Model Capabilities",
      "type": "array"
    },
    "context_budget": {
      "default": 32000,
      "maximum": 200000,
      "minimum": 1,
      "title": "Context Budget",
      "type": "integer"
    },
    "purpose": {
      "default": "runtime",
      "enum": [
        "runtime",
        "test"
      ],
      "title": "Purpose",
      "type": "string"
    }
  },
  "required": [
    "bindings"
  ],
  "title": "SkillLoadRequest",
  "type": "object"
}
