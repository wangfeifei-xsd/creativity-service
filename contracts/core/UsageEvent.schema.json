{
  "$defs": {
    "JsonValue": {},
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Channel Id",
          "type": "string"
        },
        "data_scope_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Scope Id"
        },
        "environment": {
          "enum": [
            "dev",
            "test",
            "fat",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "subject_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        },
        "subject_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Type"
        }
      },
      "required": [
        "channel_id",
        "environment"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "$id": "urn:creativity:core:1.2.0:UsageEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Attempt Id",
      "type": "string"
    },
    "connection_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Connection Id",
      "type": "string"
    },
    "cumulative": {
      "title": "Cumulative",
      "type": "boolean"
    },
    "event_version": {
      "minimum": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "final": {
      "title": "Final",
      "type": "boolean"
    },
    "normalized_tokens": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Normalized Tokens",
      "type": "object"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "raw_usage": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Usage"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "source_request_id": {
      "title": "Source Request Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "REPORTED",
        "ESTIMATED",
        "MISSING"
      ],
      "title": "Status",
      "type": "string"
    },
    "subset_relations": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Subset Relations",
      "type": "object"
    }
  },
  "required": [
    "scope",
    "attempt_id",
    "connection_id",
    "source_request_id",
    "event_version",
    "status",
    "raw_usage",
    "normalized_tokens",
    "subset_relations",
    "cumulative",
    "final",
    "observed_at"
  ],
  "title": "UsageEvent",
  "type": "object"
}
