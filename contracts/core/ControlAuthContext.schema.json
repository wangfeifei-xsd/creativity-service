{
  "$defs": {
    "ControlScope": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "channel_id": {
          "const": "system",
          "default": "system",
          "title": "Channel Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "identity_lookup",
            "channel_directory",
            "platform_limits",
            "accounts",
            "roles",
            "catalog",
            "templates",
            "audit"
          ],
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "actor_id"
      ],
      "title": "ControlScope",
      "type": "object"
    }
  },
  "$id": "urn:creativity:core:1.2.0:ControlAuthContext",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "granted_actions": {
      "items": {
        "type": "string"
      },
      "title": "Granted Actions",
      "type": "array",
      "uniqueItems": true
    },
    "principal_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Principal Id",
      "type": "string"
    },
    "principal_type": {
      "const": "management",
      "default": "management",
      "title": "Principal Type",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ControlScope"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Session Id",
      "type": "string"
    },
    "token_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Token Digest",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "principal_id",
    "request_id",
    "session_id",
    "token_digest"
  ],
  "title": "ControlAuthContext",
  "type": "object"
}
