{
  "$defs": {
    "DisplayStatus": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tone": {
          "enum": [
            "default",
            "success",
            "processing",
            "warning",
            "error"
          ],
          "title": "Tone",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label",
        "tone"
      ],
      "title": "DisplayStatus",
      "type": "object"
    }
  },
  "$id": "urn:creativity:core:1.2.0:VersionOption",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "resource_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Resource Name"
    },
    "selectable": {
      "title": "Selectable",
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/DisplayStatus"
    },
    "unavailable_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unavailable Reason"
    },
    "version_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Version Id",
      "type": "string"
    },
    "version_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Version Label"
    }
  },
  "required": [
    "version_id",
    "resource_name",
    "version_label",
    "status",
    "selectable",
    "unavailable_reason"
  ],
  "title": "VersionOption",
  "type": "object"
}
