{
  "$defs": {
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Channel Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "dev",
            "test",
            "fat",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "subject_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        },
        "subject_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Type"
        }
      },
      "required": [
        "channel_id",
        "environment"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "$id": "urn:creativity:core:1.2.0:DeletionGuardResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed": {
      "const": true,
      "default": true,
      "title": "Allowed",
      "type": "boolean"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "operation": {
      "enum": [
        "read",
        "write",
        "restore"
      ],
      "title": "Operation",
      "type": "string"
    },
    "recovery_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Recovery Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    },
    "target_type": {
      "title": "Target Type",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "target_type",
    "target_id",
    "operation",
    "checked_at",
    "recovery_id"
  ],
  "title": "DeletionGuardResult",
  "type": "object"
}
