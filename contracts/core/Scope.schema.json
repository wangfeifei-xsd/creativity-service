{
  "$id": "urn:creativity:core:1.2.0:Scope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "channel_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Channel Id",
      "type": "string"
    },
    "environment": {
      "enum": [
        "dev",
        "test",
        "fat",
        "prod"
      ],
      "title": "Environment",
      "type": "string"
    },
    "subject_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject Id"
    },
    "subject_type": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject Type"
    }
  },
  "required": [
    "channel_id",
    "environment"
  ],
  "title": "Scope",
  "type": "object"
}
