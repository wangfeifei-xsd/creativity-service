{
  "$defs": {
    "RunError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "stage",
        "retryable",
        "request_id"
      ],
      "title": "RunError",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Channel Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "dev",
            "test",
            "fat",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "subject_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        },
        "subject_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Type"
        }
      },
      "required": [
        "channel_id",
        "environment"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "$id": "urn:creativity:core:1.2.0:Attempt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Attempt Id",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunError"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "kind": {
      "enum": [
        "model",
        "tool"
      ],
      "title": "Kind",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "source_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Request Id"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "state": {
      "enum": [
        "STARTED",
        "SUCCEEDED",
        "FAILED",
        "UNKNOWN"
      ],
      "title": "State",
      "type": "string"
    },
    "step_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Step Id",
      "type": "string"
    },
    "target_version_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Target Version Id",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "attempt_id",
    "run_id",
    "step_id",
    "kind",
    "target_version_id",
    "source_request_id",
    "state",
    "started_at",
    "finished_at",
    "error"
  ],
  "title": "Attempt",
  "type": "object"
}
