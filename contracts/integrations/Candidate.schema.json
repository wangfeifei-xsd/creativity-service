{
  "$defs": {
    "BusinessEvidence": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/EntityRef"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "title",
        "source_version",
        "observed_at"
      ],
      "title": "BusinessEvidence",
      "type": "object"
    },
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Channel Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "dev",
            "test",
            "fat",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "source_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Source Type",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "channel_id",
        "environment",
        "source_type",
        "source_id"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "JsonValue": {},
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "PriceOption": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Code",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "price": {
          "$ref": "#/$defs/Money"
        },
        "billing_unit": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Billing Unit",
          "type": "string"
        }
      },
      "required": [
        "code",
        "name",
        "price",
        "billing_unit"
      ],
      "title": "PriceOption",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entity_ref": {
      "$ref": "#/$defs/EntityRef"
    },
    "entity_type": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Entity Type",
      "type": "string"
    },
    "title": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "attributes": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Attributes",
      "type": "object"
    },
    "price_options": {
      "items": {
        "$ref": "#/$defs/PriceOption"
      },
      "title": "Price Options",
      "type": "array"
    },
    "availability": {
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE",
        "UNKNOWN"
      ],
      "title": "Availability",
      "type": "string"
    },
    "availability_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Availability Name",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "source_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Version",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/BusinessEvidence"
      },
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "entity_ref",
    "entity_type",
    "title",
    "attributes",
    "price_options",
    "availability",
    "availability_name",
    "observed_at",
    "source_version",
    "evidence_refs"
  ],
  "title": "Candidate",
  "type": "object"
}
