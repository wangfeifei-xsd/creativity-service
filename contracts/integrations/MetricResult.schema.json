{
  "$defs": {
    "BusinessEvidence": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/EntityRef"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "title",
        "source_version",
        "observed_at"
      ],
      "title": "BusinessEvidence",
      "type": "object"
    },
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Channel Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "dev",
            "test",
            "fat",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "data_scope_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Data Scope Id",
          "type": "string"
        },
        "source_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Source Type",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "channel_id",
        "environment",
        "data_scope_id",
        "source_type",
        "source_id"
      ],
      "title": "EntityRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "metric_code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Metric Code",
      "type": "string"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "definition_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Definition Version",
      "type": "string"
    },
    "unit": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Unit",
      "type": "string"
    },
    "currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "period": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Period",
      "type": "string"
    },
    "timezone": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/EntityRef"
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNKNOWN"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "values": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Values",
      "type": "object"
    },
    "source_ref": {
      "$ref": "#/$defs/BusinessEvidence"
    }
  },
  "required": [
    "metric_code",
    "name",
    "definition_version",
    "unit",
    "period",
    "timezone",
    "scope",
    "completeness",
    "values",
    "source_ref"
  ],
  "title": "MetricResult",
  "type": "object"
}
