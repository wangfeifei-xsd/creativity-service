{
  "$defs": {
    "BusinessEvidence": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/EntityRef"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "title",
        "source_version",
        "observed_at"
      ],
      "title": "BusinessEvidence",
      "type": "object"
    },
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Channel Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "dev",
            "test",
            "fat",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "source_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Source Type",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "channel_id",
        "environment",
        "source_type",
        "source_id"
      ],
      "title": "EntityRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "policy_code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Policy Code",
      "type": "string"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "rule_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Rule Version",
      "type": "string"
    },
    "evidence_ref": {
      "$ref": "#/$defs/BusinessEvidence"
    }
  },
  "required": [
    "policy_code",
    "name",
    "rule_version",
    "evidence_ref"
  ],
  "title": "PolicyReference",
  "type": "object"
}
