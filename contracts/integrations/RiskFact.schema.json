{
  "$defs": {
    "BusinessEvidence": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/EntityRef"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "title",
        "source_version",
        "observed_at"
      ],
      "title": "BusinessEvidence",
      "type": "object"
    },
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Channel Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "dev",
            "test",
            "fat",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "data_scope_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Data Scope Id",
          "type": "string"
        },
        "source_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Source Type",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "channel_id",
        "environment",
        "data_scope_id",
        "source_type",
        "source_id"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "fact_code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Fact Code",
      "type": "string"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "value": {
      "$ref": "#/$defs/JsonValue"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "source": {
      "$ref": "#/$defs/EntityRef"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "validity": {
      "enum": [
        "CURRENT",
        "STALE",
        "UNKNOWN"
      ],
      "title": "Validity",
      "type": "string"
    },
    "evidence_ref": {
      "$ref": "#/$defs/BusinessEvidence"
    }
  },
  "required": [
    "fact_code",
    "name",
    "value",
    "source",
    "observed_at",
    "validity",
    "evidence_ref"
  ],
  "title": "RiskFact",
  "type": "object"
}
