{
  "$defs": {
    "RequestBinding": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD"
          ],
          "title": "Method",
          "type": "string"
        },
        "target": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^/api/v1/",
          "title": "Target",
          "type": "string"
        },
        "body_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Body Sha256",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        }
      },
      "required": [
        "method",
        "target",
        "body_sha256"
      ],
      "title": "RequestBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "subject_type": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Subject Type",
      "type": "string"
    },
    "subject_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Subject Id",
      "type": "string"
    },
    "actions": {
      "items": {
        "maxLength": 64,
        "pattern": "^[a-z_]+:[a-z_]+$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Actions",
      "type": "array"
    },
    "resources": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.-]*$": {
          "items": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
                "type": "string"
              },
              {
                "const": "*",
                "type": "string"
              }
            ]
          },
          "type": "array"
        }
      },
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Resources",
      "type": "object"
    },
    "issuer": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Issuer",
      "type": "string"
    },
    "audience": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Audience",
      "type": "string"
    },
    "issued_at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Issued At",
      "type": "integer"
    },
    "expires_at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Expires At",
      "type": "integer"
    },
    "nonce": {
      "pattern": "^[A-Za-z0-9_-]{16,128}$",
      "title": "Nonce",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/RequestBinding"
    },
    "channel_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Channel Id"
    },
    "environment": {
      "anyOf": [
        {
          "enum": [
            "dev",
            "test",
            "fat",
            "prod"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment"
    }
  },
  "required": [
    "subject_type",
    "subject_id",
    "actions",
    "resources",
    "issuer",
    "audience",
    "issued_at",
    "expires_at",
    "nonce",
    "request"
  ],
  "title": "DelegationClaims",
  "type": "object"
}
