{
  "$defs": {
    "AttachmentView": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "download_path": {
          "title": "Download Path",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "name",
        "size_bytes",
        "download_path"
      ],
      "title": "AttachmentView",
      "type": "object"
    },
    "BusinessResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "business_status": {
          "enum": [
            "COMPLETED",
            "NEEDS_INPUT",
            "NO_MATCH",
            "INSUFFICIENT_DATA",
            "PARTIAL"
          ],
          "title": "Business Status",
          "type": "string"
        },
        "data": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Data",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "business_status",
        "data",
        "warnings",
        "evidence_refs"
      ],
      "title": "BusinessResult",
      "type": "object"
    },
    "EvidenceLocation": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field Path"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text End"
        }
      },
      "required": [
        "field_path",
        "text_start",
        "text_end"
      ],
      "title": "EvidenceLocation",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "title": "Source Version",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/EvidenceLocation"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "authorized_actions": {
          "items": {
            "type": "string"
          },
          "title": "Authorized Actions",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "scope",
        "source_type",
        "source_id",
        "source_version",
        "observed_at",
        "location",
        "title",
        "authorized_actions"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "JsonValue": {},
    "MessageView": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "title": "Message Id",
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Turn Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "role_label": {
          "title": "Role Label",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "status_label": {
          "title": "Status Label",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/AttachmentView"
          },
          "title": "Attachments",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "turn_id",
        "run_id",
        "sequence",
        "role",
        "role_label",
        "status",
        "status_label",
        "text",
        "attachments",
        "created_at"
      ],
      "title": "MessageView",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Channel Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "dev",
            "test",
            "fat",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "data_scope_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Scope Id"
        },
        "subject_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Type"
        },
        "subject_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        }
      },
      "required": [
        "channel_id",
        "environment"
      ],
      "title": "Scope",
      "type": "object"
    },
    "TurnView": {
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "title": "Turn Id",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "version_label": {
          "title": "Version Label",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "state_label": {
          "title": "State Label",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/BusinessResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result Label"
        },
        "output_schema": {
          "additionalProperties": true,
          "title": "Output Schema",
          "type": "object"
        },
        "source_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Run Id"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Seconds"
        },
        "can_cancel": {
          "title": "Can Cancel",
          "type": "boolean"
        },
        "can_view_run": {
          "title": "Can View Run",
          "type": "boolean"
        }
      },
      "required": [
        "turn_id",
        "sequence",
        "run_id",
        "version_label",
        "state",
        "state_label",
        "result",
        "result_label",
        "output_schema",
        "source_run_id",
        "duration_seconds",
        "can_cancel",
        "can_view_run"
      ],
      "title": "TurnView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/MessageView"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "has_more": {
      "title": "Has More",
      "type": "boolean"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/TurnView"
      },
      "title": "Turns",
      "type": "array"
    }
  },
  "required": [
    "items",
    "next_cursor",
    "has_more",
    "turns"
  ],
  "title": "MessagePage",
  "type": "object"
}
