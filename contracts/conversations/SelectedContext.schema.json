{
  "$defs": {
    "BusinessResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "business_status": {
          "enum": [
            "COMPLETED",
            "NEEDS_INPUT",
            "NO_MATCH",
            "INSUFFICIENT_DATA",
            "PARTIAL"
          ],
          "title": "Business Status",
          "type": "string"
        },
        "data": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Data",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "business_status",
        "data",
        "warnings",
        "evidence_refs"
      ],
      "title": "BusinessResult",
      "type": "object"
    },
    "EvidenceLocation": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field Path"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text End"
        }
      },
      "required": [
        "field_path",
        "text_start",
        "text_end"
      ],
      "title": "EvidenceLocation",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "title": "Source Version",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/EvidenceLocation"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "authorized_actions": {
          "items": {
            "type": "string"
          },
          "title": "Authorized Actions",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "scope",
        "source_type",
        "source_id",
        "source_version",
        "observed_at",
        "location",
        "title",
        "authorized_actions"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "JsonValue": {},
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Channel Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "dev",
            "test",
            "fat",
            "prod"
          ],
          "title": "Environment",
          "type": "string"
        },
        "subject_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Type"
        },
        "subject_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        }
      },
      "required": [
        "channel_id",
        "environment"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "instructions": {
      "title": "Instructions",
      "type": "string"
    },
    "current_input": {
      "additionalProperties": true,
      "title": "Current Input",
      "type": "object"
    },
    "current_content_parts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Current Content Parts",
      "type": "array"
    },
    "source_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Run Id"
    },
    "confirmed_conditions": {
      "additionalProperties": true,
      "title": "Confirmed Conditions",
      "type": "object"
    },
    "followup_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/BusinessResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "messages": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Messages",
      "type": "array"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Summary"
    },
    "included_message_ids": {
      "items": {
        "type": "string"
      },
      "title": "Included Message Ids",
      "type": "array"
    },
    "truncation": {
      "additionalProperties": true,
      "title": "Truncation",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "instructions",
    "current_input",
    "current_content_parts",
    "source_run_id",
    "confirmed_conditions",
    "followup_result",
    "messages",
    "summary",
    "included_message_ids",
    "truncation"
  ],
  "title": "SelectedContext",
  "type": "object"
}
