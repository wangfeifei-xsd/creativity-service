{
  "$defs": {
    "AttachmentPart": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "attachment",
          "default": "attachment",
          "title": "Type",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "AttachmentPart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "client_message_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Client Message Id",
      "type": "string"
    },
    "content": {
      "maxLength": 100000,
      "minLength": 1,
      "title": "Content",
      "type": "string"
    },
    "input": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input"
    },
    "attachments": {
      "items": {
        "$ref": "#/$defs/AttachmentPart"
      },
      "maxItems": 10,
      "title": "Attachments",
      "type": "array"
    },
    "agent_code": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Code"
    }
  },
  "required": [
    "client_message_id",
    "content"
  ],
  "title": "MessageInput",
  "type": "object"
}
