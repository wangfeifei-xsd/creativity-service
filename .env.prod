# 生产（prod）；空项在本文件填写，或通过部署环境变量注入。
# 实际地址、账号及密钥不提交到仓库；API、Worker、Beat 使用同一环境配置。
CREATIVITY_ENVIRONMENT=prod
CREATIVITY_LOG_LEVEL=INFO
CREATIVITY_LOG_DIRECTORY=log/prod
CREATIVITY_LOG_MAX_BYTES=10485760
CREATIVITY_LOG_BACKUP_COUNT=5
CREATIVITY_DATABASE_URL=
CREATIVITY_REDIS_CACHE_URL=
CREATIVITY_REDIS_AUTH_URL=
CREATIVITY_CELERY_BROKER_URL=
CREATIVITY_CELERY_RESULT_URL=
CREATIVITY_REDIS_KEY_PREFIX=creativity-prod
# 必须挂载该环境所有 API/Worker 共用的独立持久卷，不能随旧数据库回滚。
CREATIVITY_DELETION_LEDGER_PATH=/var/lib/creativity/prod/deletion-ledger
CREATIVITY_MANAGEMENT_TOKEN_TTL=28800
CREATIVITY_SERVICE_TOKEN_TTL=3600
CREATIVITY_OSS_ENDPOINT=
CREATIVITY_OSS_REGION=cn-beijing
CREATIVITY_OSS_ACCESS_KEY_ID=
CREATIVITY_OSS_ACCESS_KEY_SECRET=
CREATIVITY_OSS_BUCKET=creativity-prod
CREATIVITY_HEALTH_TIMEOUT_SECONDS=10
CREATIVITY_CORS_ORIGINS=[]
CREATIVITY_OTEL_ENABLED=false
# 启用时填写采集器基地址；程序追加 /v1/traces。
# CREATIVITY_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318


# Redis 四项须指定互不相同的数据库编号；MySQL 使用该环境独立的数据库。
# MCP 仅接受服务端登记的渠道、环境和目的地；内网须明确 allowed_networks。
CREATIVITY_MCP_DESTINATIONS=[]

# Qdrant REST API 地址与认证信息使用该环境的实际配置。
CREATIVITY_QDRANT_URI=
CREATIVITY_QDRANT_API_KEY=
CREATIVITY_QDRANT_COLLECTION_PREFIX=creativity_memory_prod
CREATIVITY_QDRANT_TIMEOUT_SECONDS=10

# 桶内自动追加部署环境，再保留原有渠道对象路径。
CREATIVITY_OSS_PATH_PREFIX=creativity/
