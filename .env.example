# 以下凭据仅用于本地开发；生产凭据通过部署环境注入。
CREATIVITY_ENVIRONMENT=development
CREATIVITY_LOG_LEVEL=INFO
CREATIVITY_DATABASE_URL=postgresql+psycopg://creativity:creativity_local@127.0.0.1:55432/creativity
CREATIVITY_REDIS_CACHE_URL=redis://127.0.0.1:56379/0
CREATIVITY_REDIS_AUTH_URL=redis://127.0.0.1:56379/1
CREATIVITY_CELERY_BROKER_URL=redis://127.0.0.1:56379/2
CREATIVITY_CELERY_RESULT_URL=redis://127.0.0.1:56379/3
CREATIVITY_REDIS_KEY_PREFIX=creativity
# 本地开发路径；部署时必须改为所有 API/Worker 共用的独立持久卷，不能随旧数据库回滚。
CREATIVITY_DELETION_LEDGER_PATH=.local/deletion-ledger
CREATIVITY_MANAGEMENT_TOKEN_TTL=7200
CREATIVITY_SERVICE_TOKEN_TTL=3600
CREATIVITY_S3_ENDPOINT_URL=http://127.0.0.1:59000
CREATIVITY_S3_REGION=us-east-1
CREATIVITY_S3_ACCESS_KEY_ID=creativity_local
CREATIVITY_S3_SECRET_ACCESS_KEY=creativity_local_secret
CREATIVITY_S3_BUCKET=creativity-dev
CREATIVITY_HEALTH_TIMEOUT_SECONDS=3
CREATIVITY_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
CREATIVITY_OTEL_ENABLED=false
# 启用时填写采集器基地址；程序追加 /v1/traces。
# CREATIVITY_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# 仅供本地 Compose 使用，需与上方服务连接配置保持一致。
DEV_POSTGRES_USER=creativity
DEV_POSTGRES_PASSWORD=creativity_local
DEV_POSTGRES_DB=creativity
DEV_POSTGRES_PORT=55432
DEV_REDIS_PORT=56379
DEV_S3_PORT=59000
DEV_S3_CONSOLE_PORT=59001

# MCP 仅接受服务端登记的渠道、环境和目的地；内网须明确 allowed_networks。
CREATIVITY_MCP_DESTINATIONS=[]
# CREATIVITY_MCP_KEY_VERSION=填写当前主密钥版本
# CREATIVITY_MCP_ENCRYPTION_KEYS={"主密钥版本":"填写三十二字节密钥的 Base64 编码"}
